#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>

#include "multi-die-cpp.h"

#include "t603x-common.dtsi"

/ {

	compatible = "apple,t6031", "apple,arm-platform";

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		nonposted-mmio;

		ranges;
		// filled via templates at the end of the file
	};
};

#define DIE
#define DIE_NO 0

&{/soc} {
	#include "t603x-die0.dtsi"
	#include "t603x-dieX.dtsi"
	//#include "t602x-nvme.dtsi"
};

#include "t603x-gpio-pins.dtsi"
#include "t6031-pmgr.dtsi"

#undef DIE
#undef DIE_NO


