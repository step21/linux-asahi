/*
 * Apple T6031 "M3 Max" SoC
 *
 * Copyright The Asahi Linux Contributors
 */

#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "apple,t6031", "apple,arm-platform";

	#address-cells = <2>;
	#size-cells = <2>;

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>;};
				core1 { cpu = <&cpu1>;};
				core2 { cpu = <&cpu2>;};
				core3 { cpu = <&cpu3>;};

			};
			cluster1 {
				core4 { cpu = <&cpu4>; };
				core5 { cpu = <&cpu5>; };
				core6 { cpu = <&cpu6>; };
				core7 { cpu = <&cpu7>; };
				core8 { cpu = <&cpu8>; };				
				core9 { cpu = <&cpu9>; };
			};
			cluster2 {
				core10 { cpu = <&cpu10>; };
				core11 { cpu = <&cpu11>; };
				core12 { cpu = <&cpu12>; };
				core13 { cpu = <&cpu13>; };
				core14 { cpu = <&cpu14>; };
				core15 { cpu = <&cpu15>; };
			};
		};

		cpu0: cpu@0 {
			compatible = "apple,sawooth";
			device_type = "cpu";
			reg = <0x0 0x0>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu1: cpu@1 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x0 0x1>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu2: cpu@2 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x0 0x2>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu3: cpu@3 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x0 0x3>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu4: cpu@10100 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu5: cpu@10101 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu6: cpu@10102 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu7: cpu@10103 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu8: cpu@10104 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10104>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu9: cpu@10105 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10105>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu10: cpu@10200 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10200>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu11: cpu@10201 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10201>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu12: cpu@10202 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10202>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu13: cpu@10203 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10203>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu14: cpu@10204 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10204>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu15: cpu@10205 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x0 0x10205>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		l2_cache_0: l2-cache-0 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x400000>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&aic>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
	};

	clkref: clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clkref";
	};

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		nonposted-mmio;

		ranges;

		serial0: serial@391200000 {
			compatible = "apple,s5l-uart";
    		reg = <0x3 0x91200000 0x0 0x4000>;
			reg-io-width = <4>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1046 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkref>, <&clkref>;
			clock-names = "clkref", "uart";
			status = "enabled";
		};


        aic: interrupt-controller@292400000 {
            compatible = "apple,aic3";
            #interrupt-cells = <3>;
			#address-cells = <0>;
            interrupt-controller;

            /* 
            * reg[0]: Main MMIO range (approx 1.8 MB)
            * reg[1]: CPU Event/IACK register page (Base + 0x40000)
            */
            reg = <0x00000002 0x92400000 0x00000000 0x1cc000>,
                <0x00000002 0x92440000 0x00000000 0x4000>;

			reg-names = "core", "event";
            config-offset = <0x10000>;
            cap0-offset = <0x4>;
            maxnumirq-offset = <0xc>;
			power-domains = <&ps_aic>;
        };

	// tentative pmgr
	pmgr: power-management@92800000 {
		compatible = "apple,t6031-pmgr", "apple,pmgr", "syscon", "simple-mfd";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0x0 0x92800000 0x0 0x1e0000>;
		/* child nodes are added in t6031-pmgr.dtsi */
	};

	pmgr_mini: power-management@a02c0000 {
		compatible = "apple,t6031-pmgr", "apple,pmgr", "syscon", "simple-mfd";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0x0 0xa02c0000 0x0 0x4000>;
		/* child nodes are added in t6031-pmgr.dtsi */
	};

	wdt: watchdog@a02d4000 {
		// 		compatible = "apple,t6031-wdt", "apple,wdt";
		compatible = "apple,t6031-wdt", "apple,wdt";
		reg = <0x0 0xa02d4000 0x0 0x4000>;
		clocks = <&clkref>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 718 IRQ_TYPE_LEVEL_HIGH>;
	};

	mtp_mbox: mbox@ac408000 {
		compatible = "apple,t6031-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x0 0xac408000 0x0 0x4000>;

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 692 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 693 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 694 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 695 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
	};

	mtp_dart: iommu@ac808000 {
		compatible = "apple,t8110-dart";
		reg = <0x0 0xac808000 0x0 0x4000>;

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 675 IRQ_TYPE_LEVEL_HIGH>;

		#iommu-cells = <1>;
	};

	/*
	 mtp_dart: iommu@ac808000 {
		compatible = "apple,t8110-dart";
		reg = <0x0 0xac808000 0x0 0x4000>,
		      <0x0 0xac80c000 0x0 0x4000>;

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 675 IRQ_TYPE_LEVEL_HIGH>;

		#iommu-cells = <1>;
	}; */

	mtp_dockchannel: fifo@acb14000 {
		compatible = "apple,t8122-dockchannel";
		reg = <0x0 0xacb14000 0x0 0x4000>;

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 676 IRQ_TYPE_LEVEL_HIGH>;

		ranges;
		#address-cells = <2>;
		#size-cells = <2>;

		interrupt-controller;
		#interrupt-cells = <2>;
		nonposted-mmio;

		mtp_hid: input@acb30000 {
			compatible = "apple,t8122-dockchannel-hid";
			reg = <0x0 0xacb30000 0x0 0x4000>,
			      <0x0 0xacb34000 0x0 0x4000>,
			      <0x0 0xac400000 0x0 0x6c000>,
			      <0x0 0xac050000 0x0 0x4000>;
			reg-names = "config", "data", "coproc-asc", "coproc-sram";

			mboxes = <&mtp_mbox>;
			iommus = <&mtp_dart 1>;

			interrupt-parent = <&mtp_dockchannel>;
			interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
				     <3 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "tx", "rx";

			keyboard: keyboard {
				/* Filled by bootloader */
				hid-country-code = <0>;
			};
		};
	};
    };
};
