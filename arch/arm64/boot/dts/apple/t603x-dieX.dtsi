	DIE_NODE(pinctrl_aop): pinctrl@a8824000 {
			compatible = "apple,t6031-pinctrl", "apple,pinctrl";
			reg = <0x0 0xa8824000 0x0 0x4000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_aop 0 0 102>;
			apple,npins = <102>;

			interrupt-controller;
			#interrupt-cells = <2>;
		};

		pinctrl_nub: pinctrl@a01f0000 {
			compatible = "apple,t6031-pinctrl", "apple,pinctrl";
			reg = <0x0 0xa01f0000 0x0 0x4000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_nub 0 0 59>;
			apple,npins = <59>;

			interrupt-controller;
			#interrupt-cells = <2>;
		};

		pinctrl_smc: pinctrl@a4820000 {
			compatible = "apple,t6031-pinctrl", "apple,pinctrl";
			reg = <0x0 0xa4820000 0x0 0x4000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_smc 0 0 30>;
			apple,npins = <30>;

			interrupt-controller;
			#interrupt-cells = <2>;
		};

 // pinctrl_nub?

		DIE_NODE(pmgr0): power-management@292280000 {
		compatible = "apple,t6031-pmgr", "apple,pmgr", "syscon", "simple-mfd";
		#address-cells = <1>;
		#size-cells = <1>;

		reg = <0x2 0x92280000 0 0xc000>;
		};

		DIE_NODE(pmgr1): power-management@292800000 {
		compatible = "apple,t6031-pmgr", "apple,pmgr", "syscon", "simple-mfd";
		#address-cells = <1>;
		#size-cells = <1>;

		reg = <0x2 0x92800000 0 0x4000>;
		};

		DIE_NODE(pmgr2): power-management@2a0280000 {
		compatible = "apple,t6031-pmgr", "apple,pmgr", "syscon", "simple-mfd";
		#address-cells = <1>;
		#size-cells = <1>;

		reg = <0x2 0xa0280000 0 0x4000>;
		};

		DIE_NODE(pmgr3): power-management@408e80000 {
		compatible = "apple,t6031-pmgr", "apple,pmgr", "syscon", "simple-mfd";
		#address-cells = <1>;
		#size-cells = <1>;

		reg = <0x4 0x8e80000 0 0x4000>;
		};

