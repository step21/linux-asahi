/*
 * Nodes present on both dies of T603? (M3 Ultra) and present on M3 Pro/Max
 * Apple T6030 / T6031 "M3 Pro" / "M3 Max".
 *
 * Copyright The Asahi Linux Contributors
 */

 // cpufreq?

	DIE_NODE(pinctrl_ap): pinctrl@b3000000 {
			compatible = "apple,t6031-pinctrl", "apple,t6020-pinctrl", "apple,t8103-pinctrl", "apple,pinctrl";
			reg = <0x0 0xb3000000 0x0 0x100000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&DIE_NODE(pinctrl_ap) 0 0 200>;
			apple,npins = <200>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 458 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 459 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 460 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 461 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 462 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 463 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 464 IRQ_TYPE_LEVEL_HIGH>;
	};

